FROM docker.io/archlinux:base
RUN pacman -Sy --noconfirm --needed xorg-server-xvfb xorg-xauth \
    gtk3 alsa-lib mesa libdrm libxkbcommon libnotify nss libxss libxtst xdg-utils libsecret \
    && pacman -Scc --noconfirm
RUN useradd --create-home app
USER app
ENV INLARK_DATA_DIR=/tmp/inlark-smoke
# Nested Chromium namespaces are unavailable in many rootless container hosts.
# Only this isolated, network-disabled packaging smoke uses --no-sandbox.
CMD ["sh", "-c", "mkdir -p /tmp/package && bsdtar -xf /release/Inlark-0.1.0-x64.pacman -C /tmp/package && xvfb-run -a /tmp/package/opt/Inlark/inlark --smoke-test --no-sandbox --disable-gpu"]
